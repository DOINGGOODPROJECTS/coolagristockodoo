<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agriware_supplier_list" model="ir.ui.view">
        <field name="name">agriware.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Supplier Records">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_agriware_supplier_form" model="ir.ui.view">
        <field name="name">agriware.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="agriware_is_supplier"/>
            </xpath>
        </field>
    </record>

    <record id="action_agriware_suppliers" model="ir.actions.act_window">
        <field name="name">Supplier Records</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('agriware_is_supplier', '=', True), '|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_agriware_is_supplier': True}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_agriware_supplier_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_agriware_supplier_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No supplier records found.
            </p>
            <p>
                Create a supplier here or synchronize it from a connected WMS.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_agriware_suppliers"
        name="Supplier Records"
        parent="menu_agriware_suppliers_root"
        action="action_agriware_suppliers"
        sequence="50"
        groups="stock.group_stock_user"
    />

    <record id="action_agriware_supplier_mappings" model="ir.actions.act_window">
        <field name="name">Supplier Synchronization Mappings</field>
        <field name="res_model">agriware.external.id.mapping</field>
        <field name="view_mode">list</field>
        <field name="domain">[('res_model', '=', 'res.partner')]</field>
        <field name="help" type="html"><p>Supplier identities registered by inbound WMS requests. Creation time is when the mapping was established; it is not a last synchronization timestamp.</p></field>
    </record>
    <menuitem id="menu_agriware_supplier_mappings" name="Supplier Synchronization"
              parent="menu_agriware_suppliers_root" action="action_agriware_supplier_mappings"
              sequence="60" groups="agriware_connector.group_agriware_administrator"/>
</odoo>
