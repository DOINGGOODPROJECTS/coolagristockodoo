<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agriware_inventory_import_list" model="ir.ui.view">
        <field name="name">agriware.inventory.import.list</field>
        <field name="model">agriware.inventory.import</field>
        <field name="arch" type="xml">
            <list string="Inventory Imports" decoration-warning="state == 'stale'" decoration-muted="state == 'rejected'" decoration-success="state in ('approved', 'applied')">
                <field name="external_reference"/>
                <field name="external_system_id"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="submitted_at"/>
                <field name="submitted_by"/>
                <field name="state" widget="badge"/>
                <field name="applied_at"/>
            </list>
        </field>
    </record>

    <record id="view_agriware_inventory_import_form" model="ir.ui.view">
        <field name="name">agriware.inventory.import.form</field>
        <field name="model">agriware.inventory.import</field>
        <field name="arch" type="xml">
            <form string="Inventory Import">
                <header>
                    <button name="action_recalculate" type="object" string="Recalculate"
                            invisible="state in ('approved', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state not in ('pending_review', 'stale')"
                            confirm="Approving only records a review decision -- it does NOT change Odoo's actual stock. Applying the counted quantities still requires a separate, manual step in Inventory's own Physical Inventory screen. Continue?"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('pending_review', 'stale')"/>
                    <field name="applied_by"/>
                    <field name="applied_at"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_review,stale,approved,rejected,applied"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ('pending_review', 'stale', 'approved')">
                        This is a staged WMS stock observation, not an applied inventory count.
                        Approve records a human review decision but does not change stock.
                        See the import mode and native inventory adjustment instructions in
                        docs/INITIAL_INVENTORY_IMPORT.md.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'applied'">
                        This count was applied automatically by an explicitly enabled WMS integration.
                        The submitting integration user and application time are recorded above.
                    </div>
                    <group>
                        <group>
                            <field name="external_reference"/>
                            <field name="external_system_id"/>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="submitted_at"/>
                            <field name="submitted_by"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Lines"
                                      decoration-warning="validation_status == 'stale'">
                                    <field name="product_id"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="external_unit_code"/>
                                    <field name="original_reported_quantity"/>
                                    <field name="uom_id"/>
                                    <field name="reported_quantity"/>
                                    <field name="current_odoo_quantity"/>
                                    <field name="proposed_difference"/>
                                    <field name="validation_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agriware_inventory_import_search" model="ir.ui.view">
        <field name="name">agriware.inventory.import.search</field>
        <field name="model">agriware.inventory.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_reference"/>
                <field name="external_system_id"/>
                <field name="warehouse_id"/>
                <filter name="attention" string="Needs Review" domain="[('state', 'in', ['pending_review', 'stale'])]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="applied" string="Applied Automatically" domain="[('state', '=', 'applied')]"/>
                <separator/>
                <filter name="submitted" string="Submitted" date="submitted_at"/>
                <group>
                    <filter name="state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="system" string="WMS" context="{'group_by': 'external_system_id'}"/>
                    <filter name="warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agriware_inventory_imports" model="ir.actions.act_window">
        <field name="name">Inventory Imports</field>
        <field name="res_model">agriware.inventory.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inventory imports staged yet.
            </p>
            <p>
                Review inventory counts received from your WMS, including
                automatically applied adjustments. Inventory managers can approve
                or reject staged counts. Automatic application is configured
                separately for each connected WMS, with a maximum allowed variance.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_agriware_inventory_imports"
        name="Inventory Imports"
        parent="menu_agriware_root"
        action="action_agriware_inventory_imports"
        sequence="95"
        groups="stock.group_stock_user"
    />

</odoo>
