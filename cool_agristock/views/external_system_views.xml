<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cool_agristock_external_system_list" model="ir.ui.view">
        <field name="name">cool_agristock.external.system.list</field>
        <field name="model">cool_agristock.external.system</field>
        <field name="arch" type="xml">
            <list string="External Systems">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="allow_automatic_inventory_adjustments"/>
                <field name="max_auto_inventory_delta"
                       invisible="not allow_automatic_inventory_adjustments"/>
            </list>
        </field>
    </record>

    <record id="view_cool_agristock_external_system_form" model="ir.ui.view">
        <field name="name">cool_agristock.external.system.form</field>
        <field name="model">cool_agristock.external.system</field>
        <field name="arch" type="xml">
            <form string="External System">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Main Warehouse WMS"/>
                        <field name="code" placeholder="e.g. primary_wms"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="allow_automatic_inventory_adjustments"/>
                        <field name="max_auto_inventory_delta"
                               invisible="not allow_automatic_inventory_adjustments"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cool_agristock_external_systems" model="ir.actions.act_window">
        <field name="name">External Systems</field>
        <field name="res_model">cool_agristock.external.system</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external systems registered yet.
            </p>
            <p>
                Register the warehouse management system(s) this company
                integrates with. Each registered system gets its own
                namespace for external ID mappings, so rotating an API
                key never affects existing mappings.
            </p>
        </field>
    </record>

    <!-- Read-only: mappings are created and managed by the mapping
         service (inbound REST endpoints), not hand-edited by
         administrators; see security/ir.model.access.csv, which
         grants this group read access only. -->
    <record id="view_cool_agristock_external_id_mapping_list" model="ir.ui.view">
        <field name="name">cool_agristock.external.id.mapping.list</field>
        <field name="model">cool_agristock.external.id.mapping</field>
        <field name="arch" type="xml">
            <list string="External ID Mappings" create="0" edit="0" delete="0">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="external_system_id"/>
                <field name="res_model"/>
                <field name="external_id"/>
                <field name="res_id"/>
                <field name="create_date" string="Mapping Created"/>
                <button name="action_open_record" type="object" string="Open Odoo Record" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_cool_agristock_external_id_mapping_search" model="ir.ui.view">
        <field name="name">cool_agristock.external.id.mapping.search</field>
        <field name="model">cool_agristock.external.id.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_id"/>
                <field name="external_system_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <filter name="products" string="Products" domain="[('res_model', '=', 'product.product')]"/>
                <filter name="warehouses" string="Warehouses" domain="[('res_model', '=', 'stock.warehouse')]"/>
                <filter name="locations" string="Locations" domain="[('res_model', '=', 'stock.location')]"/>
                <filter name="lots" string="Lots" domain="[('res_model', '=', 'stock.lot')]"/>
                <filter name="suppliers" string="Suppliers" domain="[('res_model', '=', 'res.partner')]"/>
                <group>
                    <filter name="system" string="WMS" context="{'group_by': 'external_system_id'}"/>
                    <filter name="model" string="Record Type" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cool_agristock_external_id_mappings" model="ir.actions.act_window">
        <field name="name">External ID Mappings</field>
        <field name="res_model">cool_agristock.external.id.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external ID mappings yet.
            </p>
            <p>
                Mappings are created automatically as external systems
                synchronize data with Odoo. This screen is read-only.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_cool_agristock_external_systems_root"
        name="External Systems"
        parent="menu_cool_agristock_root"
        sequence="30"
        groups="cool_agristock.group_cool_agristock_administrator"
    />

    <menuitem
        id="menu_cool_agristock_external_systems"
        name="External Systems"
        parent="menu_cool_agristock_external_systems_root"
        action="action_cool_agristock_external_systems"
        sequence="10"
        groups="cool_agristock.group_cool_agristock_administrator"
    />

    <menuitem
        id="menu_cool_agristock_external_id_mappings"
        name="ID Mappings"
        parent="menu_cool_agristock_external_systems_root"
        action="action_cool_agristock_external_id_mappings"
        sequence="20"
        groups="cool_agristock.group_cool_agristock_administrator"
    />

</odoo>
