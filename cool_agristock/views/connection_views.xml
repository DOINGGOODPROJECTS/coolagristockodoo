<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cool_agristock_connection_list" model="ir.ui.view">
        <field name="name">cool_agristock.connection.list</field>
        <field name="model">cool_agristock.connection</field>
        <field name="arch" type="xml">
            <list string="WMS Connections">
                <field name="name"/>
                <field name="api_url"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_cool_agristock_connection_form" model="ir.ui.view">
        <field name="name">cool_agristock.connection.form</field>
        <field name="model">cool_agristock.connection</field>
        <field name="arch" type="xml">
            <form string="WMS Connection">

                <header>
                    <!-- Not part of the current API-first architecture
                         (the REST API never reads this model): hidden until
                         an outbound WMS connection feature is implemented. -->
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                        invisible="1"
                    />
                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="api_url"/>
                        <field name="api_key" password="True"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_cool_agristock_connections" model="ir.actions.act_window">
        <field name="name">WMS Connections</field>
        <field name="res_model">cool_agristock.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_cool_agristock_root"
        name="Cool Agristock"
        sequence="50"
    />

    <!-- An earlier version of this module declared groups="base.group_system"
         here. The `groups` shortcut only ever adds to group_ids on upgrade
         and never removes a previously-declared group, so on any database
         upgraded from that version (not a fresh install) this root menu
         would still silently carry that stale restriction, hiding the
         entire Cool Agristock app, including API Management, from
         Cool Agristock Administrators who aren't also full System Administrators.
         This explicit (6, 0, []) clears it, matching what a fresh install
         already has (no restriction; visibility is left entirely to each
         child menu's own groups). -->
    <record id="menu_cool_agristock_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [])]"/>
    </record>

    <!-- Not used by the current API-first architecture: the REST API is
         inbound-only (external WMS -> Odoo) and never reads this model.
         This screen was built for a different, outbound direction that
         isn't implemented. Hidden from normal users rather than removed,
         so existing cool_agristock.connection records and this module's views
         and access rights are fully preserved; it remains reachable by
         enabling "Technical Features" in Settings > Users. -->
    <menuitem
        id="menu_cool_agristock_connections"
        name="WMS Connections"
        parent="menu_cool_agristock_root"
        action="action_cool_agristock_connections"
        sequence="10"
    />

    <!-- The `groups` attribute above is additive on upgrade (it only ever
         adds group ids to group_ids, never removes a previously-declared
         one), so switching this menu from base.group_system to
         base.group_no_one via that shortcut alone would leave every System
         Administrator still able to see it on an existing install. This
         explicit (6, 0, ...) replace is required to actually restrict it. -->
    <record id="menu_cool_agristock_connections" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

</odoo>
