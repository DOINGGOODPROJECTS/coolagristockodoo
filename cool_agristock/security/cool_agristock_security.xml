<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cool Agristock application privilege -->
    <record id="privilege_cool_agristock"
            model="res.groups.privilege">

        <field name="name">Cool Agristock</field>
        <field name="sequence">50</field>

    </record>

    <!-- External WMS API integration user -->
    <record id="group_cool_agristock_api_user"
            model="res.groups">

        <field name="name">Cool Agristock API User</field>

        <field name="privilege_id"
               ref="cool_agristock.privilege_cool_agristock"/>

        <!-- The API reads/writes stock.picking, stock.move, stock.quant,
             product.product, stock.warehouse, and res.partner. Without the
             underlying Inventory access, every receipt/dispatch endpoint
             would reject this group's own members with 403. -->
        <field name="implied_ids"
               eval="[(4, ref('stock.group_stock_user'))]"/>

        <field name="comment">
            Allows authorized external warehouse management systems
            to communicate with Odoo through the Cool Agristock API.
        </field>

    </record>

    <!-- Cool Agristock administrator -->
    <record id="group_cool_agristock_administrator"
            model="res.groups">

        <field name="name">Cool Agristock Administrator</field>

        <field name="privilege_id"
               ref="cool_agristock.privilege_cool_agristock"/>

        <field name="implied_ids"
               eval="[(4, ref('cool_agristock.group_cool_agristock_api_user'))]"/>

        <field name="comment">
            Allows authorized administrators to configure and
            manage Cool Agristock integrations.
        </field>

    </record>

    <!-- Each company only ever sees and manages its own API keys. -->
    <record id="rule_cool_agristock_api_key_company" model="ir.rule">
        <field name="name">Cool Agristock API Key: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_api_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees and manages its own external systems. -->
    <record id="rule_cool_agristock_external_system_company" model="ir.rule">
        <field name="name">Cool Agristock External System: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_external_system"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own external ID mappings. -->
    <record id="rule_cool_agristock_external_id_mapping_company" model="ir.rule">
        <field name="name">Cool Agristock External ID Mapping: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_external_id_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own UOM mappings. -->
    <record id="rule_cool_agristock_uom_mapping_company" model="ir.rule">
        <field name="name">Cool Agristock UOM Mapping: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_uom_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own inventory imports. -->
    <record id="rule_cool_agristock_inventory_import_company" model="ir.rule">
        <field name="name">Cool Agristock Inventory Import: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_inventory_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cool_agristock_inventory_import_line_company" model="ir.rule">
        <field name="name">Cool Agristock Inventory Import Line: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_inventory_import_line"/>
        <field name="domain_force">[('import_id.company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own WMS transaction identities. -->
    <record id="rule_cool_agristock_wms_transaction_company" model="ir.rule">
        <field name="name">Cool Agristock WMS Transaction: multi-company</field>
        <field name="model_id" ref="model_cool_agristock_wms_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
